HOSTNAME=rpi-webdav
ADMIN_USERNAME=admin
DATA_DEVICE=/dev/sda
WEBDAV_DOMAIN=webdav.example.com
ACME_EMAIL=admin@example.com
ADMIN_SSH_PUBLIC_KEY="ssh-ed25519 AAAA_REPLACE_ME admin@laptop"
TAILSCALE_FUNNEL=true
# Optional Wi-Fi Configuration (Supports up to 4 saved networks. Leave empty if using wired Ethernet)
WIFI_SSID_1=""
WIFI_SSID_2=""
WIFI_SSID_3=""
WIFI_SSID_4=""
WIFI_COUNTRY="US"
